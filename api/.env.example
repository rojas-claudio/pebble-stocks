# Copy to .env and fill in. .env is gitignored; this file is not.

# MongoDB connection string for the quote/history cache. Required.
MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/stocks

# Shared secret for POST /api/refresh, sent by the cron trigger as the
# x-cron-secret header. Required — the endpoint refuses to run without it.
CRON_SECRET=

# Port for the local server (npm start / npm run dev). Ignored on Vercel.
PORT=3000
